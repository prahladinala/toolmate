# ==============================================================================
# ToolMate Environment Variables
# ==============================================================================
# ToolMate is a 100% frontend-only static website. No database or private keys
# are required. The variables below configure the dual-link donation strategy.

# 1. Razorpay UPI / Payment Link (India)
# Get from: https://dashboard.razorpay.com/ -> Payment Links or Payment Pages
# Example: https://rzp.io/l/your-link or https://pages.razorpay.com/your-page
NEXT_PUBLIC_RAZORPAY_URL=#razorpay-link

# 2. Buy Me a Coffee Profile Link (Global / International Cards)
# Get from: https://www.buymeacoffee.com/ -> Your profile URL
# Example: https://buymeacoffee.com/prahladinala
NEXT_PUBLIC_BUYMEACOFFEE_URL=#buymeacoffee-link

# 3. Time-triggered engagement popup threshold (seconds)
# Default is 90 seconds.
NEXT_PUBLIC_ENGAGEMENT_TIMER_SECONDS=90
